  "prerequisite_ids": [],
  "explanations": [
    {
      "id": "exp_1",
      "title": "Take away disks",
      "text": "Show 244 with disks. Take away 1 hundred, 2 tens and 1 one. Count what is left.",
      "asset_ids": [
        "a_pvc"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_2",
      "title": "Unbundle a ten",
      "text": "In 244 minus 125, 4 ones cannot lose 5. Change 1 ten for 10 ones. Now 14 ones minus 5 ones.",
      "asset_ids": [
        "a_pvc",
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_3",
      "title": "Unbundle in vertical form",
      "text": "Write the new ten and ones above the digits. Subtract ones, then tens, then hundreds.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_4",
      "title": "Check with addition",
      "text": "Add the answer and the part you took away. You should get the whole.",
      "asset_ids": [
        "a_bond"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
  ],
  "examples": [
    {
      "id": "ex_1",
      "title": "244 minus 121",
      "text": "4 ones minus 1 one is 3 ones. 4 tens minus 2 tens is 2 tens. 2 hundreds minus 1 hundred is 1 hundred. The answer is 123.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "ex_2",
      "title": "244 minus 125",
      "text": "Change 1 ten for 10 ones. 14 ones minus 5 ones is 9 ones. 3 tens minus 2 tens is 1 ten. The answer is 119.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
