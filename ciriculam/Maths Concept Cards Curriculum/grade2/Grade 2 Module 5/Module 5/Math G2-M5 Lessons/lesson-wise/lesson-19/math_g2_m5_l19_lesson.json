  "prerequisite_ids": [],
  "explanations": [
    {
      "id": "exp_1",
      "title": "Add by making a hundred",
      "text": "For 180 plus 440, break 440 into 420 and 20. 180 plus 20 is 200. Then add 200 plus 420.",
      "asset_ids": [
        "a_bond"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_2",
      "title": "Subtract by counting up",
      "text": "For 400 minus 236, ask: 236 plus what number equals 400?",
      "asset_ids": [
        "a_arrow"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_3",
      "title": "Pick what fits the numbers",
      "text": "389 is close to 400. Move 11 from 411 to 389. Then add 400 plus 400.",
      "asset_ids": [
        "a_bond"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_4",
      "title": "Related ways",
      "text": "Two ways to solve 500 minus 211 should give the same answer. Compare them.",
      "asset_ids": [
        "a_tape"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Problem Set 1"
      }
    }
  ],
  "examples": [
    {
      "id": "ex_1",
      "title": "180 plus 440",
      "text": "Move 20 from 440 to 180. That makes 200 plus 420. The total is 620.",
      "asset_ids": [
        "a_bond"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "ex_2",
      "title": "400 minus 236",
      "text": "Count up from 236 to 240 is 4. Count up from 240 to 400 is 160. The missing part is 164.",
      "asset_ids": [
        "a_arrow"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
