  "hints": [
    {
      "id": "h_1",
      "level": 1,
      "text": "Look at the numbers. Is one close to a hundred?",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_2",
      "level": 2,
      "text": "Pick the way that needs the fewest steps.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_3",
      "level": 3,
      "text": "Try the arrow way or a number bond. Then check your answer.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_4",
      "level": 1,
      "text": "Is one number close to the next hundred?",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_5",
      "level": 2,
      "text": "Break the other number into two parts. Give one part to the close number.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_6",
      "level": 3,
      "text": "Make a number bond. Add the new hundred first.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_7",
      "level": 1,
      "text": "Look at the number you take away. Is it close to a hundred?",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_8",
      "level": 2,
      "text": "Add the same amount to both numbers. The difference stays the same.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_9",
      "level": 3,
