  "explanations": [
    {
      "id": "exp_1",
      "title": "Add hundreds on the chart",
      "text": "Show 325 with disks. Add 2 hundreds disks. Now there are 5 hundreds. The tens and ones stay the same.",
      "asset_ids": [
        "a_pvc"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_2",
      "title": "Arrow way",
      "text": "To add 3 hundreds to 450, draw an arrow. Write plus 300. The hundreds change from 4 to 7.",
      "asset_ids": [
        "a_arrow"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_3",
      "title": "Number bond",
      "text": "Break 450 into 400 and 50. Add the hundreds: 400 plus 300. Then add the 50 back.",
      "asset_ids": [
        "a_bond"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_4",
      "title": "Count up to subtract",
      "text": "582 minus 300 has a missing part. Think 300 plus what number equals 582? Count up from 300.",
      "asset_ids": [
        "a_arrow"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
  ],
