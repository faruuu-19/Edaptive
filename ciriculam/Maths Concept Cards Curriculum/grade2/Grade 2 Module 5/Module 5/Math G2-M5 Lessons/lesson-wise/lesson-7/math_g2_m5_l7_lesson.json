  "explanations": [
    {
      "id": "exp_1",
      "title": "Number bond to make a hundred",
      "text": "697 is 3 away from 700. Break 223 into 3 and 220. Now add 700 plus 220.",
      "asset_ids": [
        "a_bond"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_2",
      "title": "Arrow way",
      "text": "Use arrows to make a new hundred first. Then add the hundreds and tens.",
      "asset_ids": [
        "a_arrow"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_3",
      "title": "Compensation for subtraction",
      "text": "In a subtraction, add the same amount to both numbers. The difference stays the same.",
      "asset_ids": [
        "a_tape"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_4",
      "title": "Pick the best way",
      "text": "Both ways work. Choose the way with fewer steps and check your answer.",
      "asset_ids": [],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
  ],
