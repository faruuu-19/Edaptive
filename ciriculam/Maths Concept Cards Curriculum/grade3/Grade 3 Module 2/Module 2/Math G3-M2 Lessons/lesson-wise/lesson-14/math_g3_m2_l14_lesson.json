  "explanations": [
    {
      "id": "exp_hundreds",
      "title": "Count the hundreds",
      "text": "132 has 1 hundred. The endpoints are 100 and 200. Halfway is 150.",
      "asset_ids": [
        "a_vertical_number_line"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development, Problem 1"
      }
    },
    {
      "id": "exp_round_hundred",
      "title": "Round to the nearer hundred",
      "text": "132 is less than 150, so it rounds down to 100. 3 tens is less than 5 tens.",
      "asset_ids": [
        "a_vertical_number_line"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development, Problem 1 (S: 3 tens is less than 5 tens.)"
      }
    },
    {
      "id": "exp_total_hundreds",
      "title": "Total hundreds in a big number",
      "text": "1,387 has 13 hundreds in all. Its endpoints are 13 hundreds and 14 hundreds.",
      "asset_ids": [
        "a_place_value_chart",
        "a_vertical_number_line"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Application Problem note and Concept Development, Problem 2"
      }
    },
    {
      "id": "exp_ten_vs_hundred",
      "title": "Nearest ten or nearest hundred",
      "text": "To round to the nearest hundred, look at the tens. Halfway is 5 tens, like 150.",
      "asset_ids": [],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development, Problem 1 and Student Debrief"
      }
    }
  ],
