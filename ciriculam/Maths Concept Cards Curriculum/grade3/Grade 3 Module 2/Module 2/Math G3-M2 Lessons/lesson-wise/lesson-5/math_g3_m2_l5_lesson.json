    {
      "id": "exp_part_whole",
      "title": "Parts and whole of time",
      "text": "9:00 to 9:30 is 30 minutes. 11 minutes and 19 minutes are parts. Together they make 30 minutes.",
      "asset_ids": [
        "a_time_number_line"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development, Part 2 (Gia)"
      }
    },
    {
      "id": "exp_add_or_subtract",
      "title": "Add or subtract",
      "text": "From 9:12 to 9:30, count forward: 12 plus what equals 30. Or count back: 30 minus 12 equals 18.",
      "asset_ids": [
        "a_time_number_line"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development, Part 1"
      }
    },
    {
      "id": "exp_label",
      "title": "Label known and unknown",
      "text": "Draw the number line. Label the times and minutes you know. Put a question mark on the unknown interval.",
      "asset_ids": [],
      "origin": "adapted",
      "source_ref": {
