  "explanations": [
    {
      "id": "exp_make_ten",
      "title": "Make a ten to add",
      "text": "28 is close to 30. Take 2 from 36 to make 30. Then 30 plus 34 equals 64.",
      "asset_ids": [
        "a_tape_diagram"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development, Problem 1"
      }
    },
    {
      "id": "exp_subtract_tens",
      "title": "Subtract with tens",
      "text": "For 32 minus 14, take away 10, then take away 4. 32 minus 10 is 22. 22 minus 4 is 18.",
      "asset_ids": [],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development, Problem 2 (S: How about 32 – 10 – 4?)"
      }
    },
    {
      "id": "exp_about_same",
      "title": "Suppose each is about the same",
      "text": "If each box weighs about 2 kilograms, multiply the number of boxes by 2. That is simpler than weighing each one.",
      "asset_ids": [],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development, Problem 3"
      }
    },
    {
      "id": "exp_divide_weight",
      "title": "Divide to share weight",
      "text": "8 chairs weigh 24 kilograms. Skip-count by eights to 24. Each chair weighs 3 kilograms.",
      "asset_ids": [
        "a_tape_diagram"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development, Problem 4"
      }
    }
  ],
