  "explanations": [
    {
      "id": "exp_1",
      "title": "Draw chips",
      "text": "Draw chips in the hundreds, tens and ones columns. Draw 5 chips in neat groups. Count them to add.",
      "asset_ids": [
        "a_pvc"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_2",
      "title": "Show a new unit",
      "text": "When you make 10 tens, change them for 1 hundred. Draw it, and write a 1 under the line.",
      "asset_ids": [
        "a_pvc",
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_3",
      "title": "Line up the digits",
      "text": "Write the problem going down. Line up ones, tens and hundreds. Add the ones first.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
  ],
  "examples": [
    {
      "id": "ex_1",
      "title": "126 plus 160",
      "text": "6 ones plus 0 ones is 6 ones. 2 tens plus 6 tens is 8 tens. 1 hundred plus 1 hundred is 2 hundreds. The total is 286.",
