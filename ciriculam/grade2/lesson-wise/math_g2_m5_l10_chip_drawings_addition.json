        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "ex_2",
      "title": "326 plus 167",
      "text": "6 ones plus 7 ones is 13 ones. Bundle 1 ten. Tens: 2 plus 6 plus 1 is 9. Hundreds: 3 plus 1 is 4. The total is 493.",
