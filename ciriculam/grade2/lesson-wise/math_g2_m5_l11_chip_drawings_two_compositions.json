  "explanations": [
    {
      "id": "exp_1",
      "title": "Bundle ones, then tens",
      "text": "342 plus 169: 2 ones plus 9 ones is 11 ones. Bundle 1 ten. Then the tens make 10 tens, so bundle 1 hundred.",
      "asset_ids": [
        "a_pvc",
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_2",
      "title": "Write each new unit",
      "text": "Write the new ten under the tens column. Write the new hundred under the hundreds column.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_3",
      "title": "Check with a bond",
      "text": "511 is the whole. 342 and 169 are the parts. Check that the parts make the whole.",
      "asset_ids": [
        "a_bond"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
  ],
