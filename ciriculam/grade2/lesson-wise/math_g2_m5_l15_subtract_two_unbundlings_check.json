  "explanations": [
    {
      "id": "exp_1",
      "title": "Unbundle a ten",
      "text": "In 430 minus 129, there are no ones to take 9 from. Change 1 ten for 10 ones first.",
      "asset_ids": [
        "a_pvc",
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_2",
      "title": "Unbundle twice",
      "text": "In 941 minus 587, unbundle a hundred for tens. Then unbundle a ten for ones.",
      "asset_ids": [
        "a_pvc",
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_3",
      "title": "Check with addition",
      "text": "If 762 minus 589 equals 173, then 173 plus 589 equals 762. The three numbers make a number bond.",
      "asset_ids": [
        "a_bond"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
  ],
  "examples": [
    {
      "id": "ex_1",
      "title": "430 minus 129",
      "text": "Change 1 ten for 10 ones. 10 minus 9 is 1. 2 tens minus 2 tens is 0. 4 hundreds minus 1 hundred is 3. The answer is 301.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "ex_2",
      "title": "941 minus 587",
      "text": "Unbundle a ten. 11 minus 7 is 4. Unbundle a hundred. 13 tens minus 8 tens is 5 tens. 8 hundreds minus 5 hundreds is 3. The answer is 354.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
