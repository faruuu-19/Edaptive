  "objective": {
    "id": "obj_1",
    "text": "Subtract from hundreds and from numbers with a zero in the tens place.",
    "origin": "adapted",
    "source_ref": {
      "src": "src1",
      "page": "n/a",
      "section": "Lesson objective"
    }
  },
  "prerequisite_ids": [],
  "explanations": [
    {
      "id": "exp_1",
      "title": "Unbundle from the hundreds",
      "text": "In 402 minus 231, there are 0 tens. Change 1 hundred for 10 tens. Then subtract.",
      "asset_ids": [
        "a_pvc",
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_2",
      "title": "Unbundle twice from 800",
      "text": "In 800 minus 463, there are no tens and no ones. Change 1 hundred for 10 tens. Change 1 ten for 10 ones.",
      "asset_ids": [
        "a_pvc",
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_3",
      "title": "Change both numbers",
      "text": "Take 1 from both numbers. The difference stays the same. It can make the problem friendlier.",
      "asset_ids": [
        "a_tape"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Problem Set 2"
      }
    }
  ],
  "examples": [
    {
      "id": "ex_1",
      "title": "402 minus 231",
      "text": "Change 1 hundred for 10 tens. 2 ones minus 1 one is 1 one. 10 tens minus 3 tens is 7 tens. 3 hundreds minus 2 hundreds is 1. The answer is 171.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "ex_2",
      "title": "800 minus 463",
      "text": "Change 1 hundred for 10 tens, then 1 ten for 10 ones. 10 minus 3 is 7. 9 tens minus 6 tens is 3 tens. 7 hundreds minus 4 hundreds is 3. The answer is 337.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
  ],
