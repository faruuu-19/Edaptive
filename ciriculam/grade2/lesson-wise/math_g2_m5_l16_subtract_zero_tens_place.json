  "hints": [
    {
      "id": "h_1",
      "level": 1,
      "text": "Look at the tens place. Are there enough tens to take from?",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_2",
      "level": 2,
      "text": "Change 1 hundred for 10 tens first. Then change 1 ten for 10 ones.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_3",
      "level": 3,
      "text": "Try adding 1 to both numbers. Does it make a friendlier problem?",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_4",
      "level": 1,
      "text": "Line up the ones, tens and hundreds.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_5",
      "level": 2,
      "text": "Start with the ones. Do you have enough to take away?",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_6",
      "level": 3,
      "text": "Change 1 ten for 10 ones, or 1 hundred for 10 tens.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_7",
      "level": 1,
      "text": "Check your answer with addition.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_8",
      "level": 2,
      "text": "Add the answer to the part you took away. Do you get the whole?",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_9",
      "level": 3,
      "text": "Make a number bond. The parts add up to the whole.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_10",
      "level": 1,
      "text": "Think of the ten you can make.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_11",
      "level": 2,
      "text": "Break the second number to make ten first.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_12",
      "level": 3,
      "text": "Count on or count back. Use your fingers or a number line.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_13",
      "level": 1,
      "text": "Read the story again. What do you know? What do you need to find?",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_14",
