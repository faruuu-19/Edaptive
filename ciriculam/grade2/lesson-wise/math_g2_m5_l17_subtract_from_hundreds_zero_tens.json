  "examples": [
    {
      "id": "ex_1",
      "title": "300 minus 195",
      "text": "Change 1 hundred for 10 tens. Change 1 ten for 10 ones. 10 minus 5 is 5. 9 tens minus 9 tens is 0. 2 hundreds minus 1 hundred is 1. The answer is 105.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "ex_2",
      "title": "500 minus 213",
      "text": "Unbundle a hundred, then a ten. 10 minus 3 is 7. 9 tens minus 1 ten is 8 tens. 4 hundreds minus 2 hundreds is 2. The answer is 287.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
  ],
