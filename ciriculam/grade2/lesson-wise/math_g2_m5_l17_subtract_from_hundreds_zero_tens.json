  "explanations": [
    {
      "id": "exp_1",
      "title": "Unbundle from 300",
      "text": "In 300 minus 195, change 1 hundred for 10 tens. Then change 1 ten for 10 ones.",
      "asset_ids": [
        "a_pvc",
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_2",
      "title": "Unbundle from 500",
      "text": "In 500 minus 213, there are no tens and no ones. Unbundle a hundred and a ten.",
      "asset_ids": [
        "a_pvc",
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_3",
      "title": "Zero in the tens place",
      "text": "In 603 minus 487, there are 0 tens. Change 1 hundred for 10 tens first.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
