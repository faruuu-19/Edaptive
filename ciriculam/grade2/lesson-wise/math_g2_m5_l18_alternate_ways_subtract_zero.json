  "prerequisite_ids": [],
  "explanations": [
    {
      "id": "exp_1",
      "title": "Change both numbers",
      "text": "For 300 minus 159, change both numbers by 1. The difference stays the same.",
      "asset_ids": [
        "a_tape"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_2",
      "title": "Add to subtract",
      "text": "For 400 minus 278, ask: 278 plus what number equals 400? Count up with the arrow way.",
      "asset_ids": [
        "a_arrow"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_3",
      "title": "Rename in one step",
      "text": "In 605 minus 498, change 1 hundred for 9 tens and 10 ones in one step. Then subtract.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
  ],
  "examples": [
    {
      "id": "ex_1",
      "title": "300 minus 159",
      "text": "Take 1 from both numbers. 299 minus 158 equals 141.",
      "asset_ids": [
        "a_tape"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "ex_2",
      "title": "400 minus 278",
      "text": "Count up from 278 to 300 is 22. Count up from 300 to 400 is 100. The missing part is 122.",
      "asset_ids": [
        "a_arrow"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "ex_3",
      "title": "605 minus 498",
      "text": "Rename 6 hundreds 0 tens 5 ones as 5 hundreds 10 tens 5 ones. Then subtract. The answer is 107.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
