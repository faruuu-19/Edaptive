  "objective": {
    "id": "obj_1",
    "text": "Learn 10 more, 10 less, 100 more and 100 less. Show them with plus and minus.",
    "origin": "adapted",
    "source_ref": {
      "src": "src1",
      "page": "n/a",
      "section": "Lesson objective"
    }
  },
  "prerequisite_ids": [],
  "explanations": [
    {
      "id": "exp_1",
      "title": "Add or remove a disk",
      "text": "Show 157 with disks. Add 1 tens disk to show 10 more. Add 1 hundreds disk to show 100 more.",
      "asset_ids": [
        "a_pvc"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_2",
      "title": "Say it with a sentence",
      "text": "10 more than 157 is 167. Also, 167 is 10 more than 157. We can write 157 plus 10 equals 167.",
      "asset_ids": [],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_3",
      "title": "The arrow way",
      "text": "Write the start number. Draw one arrow for each change. Plus 100 changes the hundreds. Minus 10 changes the tens.",
      "asset_ids": [
        "a_arrow"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_4",
      "title": "Number patterns",
      "text": "Look at 135, 145, 155. Each number is 10 more than the one before. The rule is plus 10.",
      "asset_ids": [],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
  ],
