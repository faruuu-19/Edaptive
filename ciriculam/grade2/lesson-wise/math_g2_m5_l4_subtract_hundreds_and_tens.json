        "a_arrow"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_2",
      "title": "Use a problem you know",
      "text": "450 minus 250 is 200. For 450 minus 260, take away 10 more.",
