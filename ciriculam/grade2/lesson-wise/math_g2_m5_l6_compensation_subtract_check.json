  "prerequisite_ids": [],
  "explanations": [
    {
      "id": "exp_1",
      "title": "Cubes",
      "text": "8 cubes minus 5 cubes leaves 3. Add 1 cube to each stick. 9 minus 6 still leaves 3.",
      "asset_ids": [
        "a_tape"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Fluency: Compensation with Linking Cubes"
      }
    },
    {
      "id": "exp_2",
      "title": "Tape diagram",
      "text": "Draw 230 and 180 as two bars. Add 20 to each bar. The new problem is 250 minus 200.",
      "asset_ids": [
        "a_tape"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_3",
      "title": "Close to a hundred",
      "text": "In 321 minus 199, 199 is 1 away from 200. Add 1 to each number. The new problem is 322 minus 200.",
      "asset_ids": [
        "a_tape"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_4",
      "title": "Check with addition",
      "text": "The answer and the part you took away add to make the whole. 122 plus 200 equals 322.",
      "asset_ids": [
        "a_bond"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
  ],
  "examples": [
