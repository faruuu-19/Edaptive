  "hints": [
    {
      "id": "h_1",
      "level": 1,
      "text": "Line up the ones, tens and hundreds.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_2",
      "level": 2,
      "text": "Start with the ones. Can you make a new ten?",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_3",
      "level": 3,
      "text": "Change 10 ones for 1 ten, or 10 tens for 1 hundred. Write it below.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_4",
      "level": 1,
      "text": "Look at the hundreds digits first. Add those.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_5",
      "level": 2,
      "text": "Add the hundreds. The tens and ones stay the same.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_6",
      "level": 3,
      "text": "Show it on the chart. Add the new hundreds disks.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_7",
      "level": 1,
      "text": "Read the story again. What do you know? What do you need to find?",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_8",
      "level": 2,
      "text": "Draw a tape diagram. Label what you know.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_9",
      "level": 3,
      "text": "Decide: do you add or take away? Then solve.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_10",
      "level": 1,
      "text": "Think of the ten you can make.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_11",
      "level": 2,
      "text": "Break the second number to make ten first.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_12",
      "level": 3,
      "text": "Count on or count back. Use your fingers or a number line.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_13",
      "level": 1,
      "text": "Look at the ones place only.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_14",
      "level": 2,
      "text": "Count the ones together. Put them in the ones column.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_15",
      "level": 3,
      "text": "Use the chart. Count the ones disks.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
