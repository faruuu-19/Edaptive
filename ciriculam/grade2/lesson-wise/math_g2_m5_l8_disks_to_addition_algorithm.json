  "objective": {
    "id": "obj_1",
    "text": "Connect place value disks to adding in vertical form. Bundle 10 ones as 1 ten.",
    "origin": "adapted",
    "source_ref": {
      "src": "src1",
      "page": "n/a",
      "section": "Lesson objective"
    }
  },
  "prerequisite_ids": [],
  "explanations": [
    {
      "id": "exp_1",
      "title": "Hard to do in your head",
      "text": "287 plus 314 is hard to add in your head. The ones place matters too. A chart and disks help.",
      "asset_ids": [
        "a_pvc"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_2",
      "title": "Bundle 10 ones",
      "text": "In 303 plus 37, 3 ones plus 7 ones is 10 ones. Change 10 ones for 1 ten. Write the 1 in the tens place below the line.",
      "asset_ids": [
        "a_pvc",
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_3",
      "title": "Bundle 10 tens",
      "text": "In 211 plus 95, 1 ten plus 9 tens is 10 tens. Change 10 tens for 1 hundred. Write the 1 in the hundreds place.",
      "asset_ids": [
        "a_pvc",
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_4",
      "title": "Match chart and vertical form",
      "text": "Every move on the chart matches one step in the vertical form. Add ones first, then tens, then hundreds.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
  ],
  "examples": [
    {
      "id": "ex_1",
      "title": "303 plus 37",
      "text": "3 ones plus 7 ones makes 10 ones, so 1 new ten. Tens: 0 plus 3 plus 1 is 4. Hundreds: 3. The total is 340.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "ex_2",
      "title": "211 plus 95",
      "text": "1 one plus 5 ones is 6 ones. 1 ten plus 9 tens is 10 tens, so 1 new hundred. Hundreds: 2 plus 1 is 3. The total is 306.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
