  "explanations": [
    {
      "id": "exp_1",
      "title": "Break apart and add",
      "text": "Break 385 into hundreds, tens and ones. Add 427 plus 300, then 80, then 5.",
      "asset_ids": [
        "a_pvc"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_2",
      "title": "Bundle 10 ones",
      "text": "In 427 plus 385, 7 ones plus 5 ones is 12 ones. Change 10 ones for 1 ten. Write the 1 below the line.",
      "asset_ids": [
        "a_pvc",
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "exp_3",
      "title": "Bundle 10 tens",
      "text": "10 tens make 1 hundred. Take away the 10 tens disks and add 1 hundreds disk.",
      "asset_ids": [
        "a_pvc",
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
  ],
  "examples": [
    {
      "id": "ex_1",
      "title": "427 plus 385",
      "text": "7 plus 5 is 12 ones. 12 ones is 1 ten 2 ones. Tens: 2 plus 8 plus 1 is 11 tens. 11 tens is 1 hundred 1 ten. Hundreds: 4 plus 3 plus 1 is 8. The total is 812.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "ex_2",
      "title": "672 plus 249",
      "text": "2 plus 9 is 11 ones, so 1 ten 1 one. Tens: 7 plus 4 plus 1 is 12 tens. Hundreds: 6 plus 2 plus 1 is 9. The total is 921.",
      "asset_ids": [
        "a_vert"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
