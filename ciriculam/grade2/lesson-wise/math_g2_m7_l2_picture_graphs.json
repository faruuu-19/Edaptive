  "explanations": [
    {
      "id": "exp_picture_graph",
      "title": "Picture graph",
      "text": "A picture graph shows data with pictures. Each picture stands for one thing. The graph has a title, labels and a key.",
      "origin": "adapted",
      "asset_ids": [
        "a_picture_graph"
      ],
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development Part 1"
      }
    },
    {
      "id": "exp_title_labels",
      "title": "Title and labels",
      "text": "The title tells what the graph is about. The labels name the categories. Write the labels in the same order as the table.",
      "origin": "adapted",
      "asset_ids": [
        "a_picture_graph"
      ],
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development Part 1 (S: So we don't get confused)"
      }
    },
    {
      "id": "exp_circle_symbol",
      "title": "A circle as a picture",
      "text": "A circle is a quick way to draw. Each circle stands for one thing. It is math, not art.",
      "origin": "adapted",
      "asset_ids": [
        "a_picture_graph"
      ],
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development Part 1"
      }
    },
    {
      "id": "exp_legend",
      "title": "Legend or key",
      "text": "The legend, or key, tells what each picture stands for. For example, each circle stands for one animal.",
      "origin": "adapted",
      "asset_ids": [
        "a_picture_graph"
      ],
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development Part 1"
      }
    },
    {
      "id": "exp_compare_frames",
      "title": "More and fewer questions",
      "text": "Say the group with fewer first in 'how many fewer'. Say the group with more first in 'how many more'. The answer is the extra pictures.",
      "origin": "adapted",
      "asset_ids": [
        "a_picture_graph"
      ],
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development Part 1; Student Debrief"
      }
    },
    {
      "id": "exp_grid_paper",
      "title": "Grid paper",
      "text": "Grid paper keeps the pictures in neat rows or columns. Fill only the squares above the labels.",
