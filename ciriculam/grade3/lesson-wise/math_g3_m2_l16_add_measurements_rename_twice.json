    {
      "id": "exp_rename_twice",
      "title": "Rename two times",
      "text": "158 plus 266: 8 ones plus 6 ones is 14 ones. Rename 1 ten. Then 12 tens, so rename 1 hundred.",
      "asset_ids": [
        "a_place_value_chart"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development, Problem 1"
      }
    },
    {
      "id": "exp_where_to_write",
      "title": "Where the new unit goes",
      "text": "A new ten goes in the tens column. A new hundred goes in the hundreds column.",
      "asset_ids": [
        "a_place_value_chart"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development, Problem 1 (we put it in the hundreds column because it's a hundred, not a ten)"
      }
    },
    {
      "id": "exp_check_scale",
      "title": "Check with a scale",
      "text": "Put both bags on the scale. It shows 424 grams, the same as our sum.",
      "asset_ids": [
        "a_scale_widget"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
