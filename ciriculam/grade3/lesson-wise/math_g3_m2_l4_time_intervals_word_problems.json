    {
      "id": "exp_efficient",
      "title": "Count in big jumps",
      "text": "From 5:31 to 5:43, count ones to 5:35, fives to 5:40, then ones to 5:43. That is 12 minutes.",
      "asset_ids": [
        "a_time_number_line"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development, Problem 1 (strategies)"
      }
    },
    {
      "id": "exp_three_kinds",
      "title": "Three kinds of time problems",
      "text": "You may need the end time, the minutes in between, or the start time.",
      "asset_ids": [],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development, Problem 1 (result, change and start unknown)"
      }
    },
    {
      "id": "exp_back_or_forward",
      "title": "Forward or backward",
      "text": "If you know the end time and want the start, count backward. If you know the start, count forward.",
      "asset_ids": [
        "a_clock_widget"
      ],
      "origin": "adapted",
      "source_ref": {
