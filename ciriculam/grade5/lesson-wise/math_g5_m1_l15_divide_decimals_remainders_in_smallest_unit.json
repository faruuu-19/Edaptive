  "hints": [
    {
      "id": "h_chart",
      "level": 1,
      "text": "Draw the place value chart. Put each digit in its own place.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_shift",
      "level": 1,
      "text": "Multiplying by ten moves every digit one place to the left. Dividing moves it right.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_zeros",
      "level": 2,
      "text": "Count the zeros in the number you multiply or divide by. That tells how many places the digits move.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_exp",
      "level": 2,
      "text": "The exponent tells how many tens are multiplied together. It matches the zeros.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_unit",
      "level": 1,
      "text": "Say the unit name. Then use a basic fact with that unit.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_conv",
      "level": 2,
      "text": "Think how many small units fit in a big unit. Then multiply or divide.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_like",
      "level": 1,
      "text": "Add or subtract like units. Tenths with tenths, hundredths with hundredths.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_regroup",
      "level": 2,
      "text": "Trade ten of a small unit for one of the next larger unit.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_cmp",
      "level": 1,
      "text": "Compare digits from the left. Find the first place where they differ.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_unitcmp",
      "level": 2,
      "text": "Rename both numbers with the same unit. Then compare.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_round",
      "level": 1,
      "text": "Find the nearest numbers on each side for that place. Then check if you are past the halfway point.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_est",
      "level": 2,
      "text": "Round the numbers and estimate first. Then place the decimal point.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_area",
      "level": 2,
      "text": "Draw an area model. Multiply each unit by the whole number. Then add the partial products.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_unbundle",
      "level": 2,
      "text": "If you cannot share a unit evenly, trade it for ten of the next smaller unit.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_tape",
      "level": 1,
      "text": "Draw a tape diagram. Label the total and the parts.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    },
    {
      "id": "h_whole",
      "level": 1,
      "text": "Divide like whole numbers first. Then think about the unit to place the decimal point.",
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development"
      }
    }
