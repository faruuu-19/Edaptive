  "explanations": [
    {
      "id": "exp_zero_ones",
      "title": "Keep sharing with smaller units",
      "text": "1.7 divided by 2: 1 one cannot be shared by 2. Trade it for 10 tenths. 17 tenths shared by 2 is 8 tenths with 1 left. Trade 1 tenth for 10 hundredths. Now 5 hundredths each. The answer is 0.85.",
      "asset_ids": [
        "a_pv_chart",
        "a_place_value_disks"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development Problems 1-2"
      }
    },
    {
      "id": "exp_same_amount",
      "title": "A trade does not change the amount",
      "text": "1 and 7 tenths is the same as 1 and 70 hundredths. We write a zero in the hundredths place to show the trade.",
      "asset_ids": [
        "a_pv_chart"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development Problems 1-2"
      }
    },
    {
      "id": "exp_whole_remainder",
      "title": "Whole numbers can give decimals",
      "text": "17 divided by 4 used to have a remainder of 1. Now trade the remainder for tenths and hundredths. The answer is 4.25.",
      "asset_ids": [
        "a_pv_chart"
      ],
      "origin": "adapted",
      "source_ref": {
        "src": "src1",
        "page": "n/a",
        "section": "Concept Development Problems 3-4"
      }
    }
  ],
