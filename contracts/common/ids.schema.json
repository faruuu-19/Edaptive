{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common identifiers",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "CurriculumNodeId": {
      "description": "Stable dotted id: <subject>.g<grade>[.<segment>]*, e.g. math.g3.m5.l12. Never reuse or renumber once published.",
      "type": "string",
      "pattern": "^(math|english|science)\\.g[1-5](\\.[a-z0-9][a-z0-9-]*)*$"
    },
    "Subject": {
      "type": "string",
      "enum": ["math", "english", "science"]
    },
    "Grade": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "Track": {
      "type": "string",
      "enum": ["track-a", "track-b", "track-c"]
    }
  }
}
