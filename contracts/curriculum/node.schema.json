{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CurriculumNode",
  "description": "One node of the curriculum graph (unit or lesson). Produced by the Curriculum Compiler (Track C); read by every module that needs to know where a student is.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject", "grade", "level", "title", "parent_id", "order", "prerequisites", "source"],
  "properties": {
    "id": { "$ref": "../common/ids.schema.json#/$defs/CurriculumNodeId" },
    "subject": { "$ref": "../common/ids.schema.json#/$defs/Subject" },
    "grade": { "$ref": "../common/ids.schema.json#/$defs/Grade" },
    "level": { "type": "string", "enum": ["unit", "lesson"] },
    "title": { "type": "string", "minLength": 1 },
    "parent_id": {
      "oneOf": [{ "$ref": "../common/ids.schema.json#/$defs/CurriculumNodeId" }, { "type": "null" }]
    },
    "order": { "description": "Position among siblings, starting at 1.", "type": "integer", "minimum": 1 },
    "prerequisites": {
      "type": "array",
      "items": { "$ref": "../common/ids.schema.json#/$defs/CurriculumNodeId" },
      "uniqueItems": true
    },
    "objectives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "license"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "license": { "type": "string" }
      }
    }
  }
}
