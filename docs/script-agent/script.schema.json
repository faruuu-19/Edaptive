{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edaptive lesson script draft 0.1",
  "type": "object",
  "required": ["schema_version", "concept_id", "assessment_card_id", "grade", "subject", "segments", "route_plan", "delivery_policy", "validation"],
  "properties": {
    "schema_version": {"const": "script-0.1"},
    "concept_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "assessment_card_id": {"type": "string", "minLength": 1},
    "grade": {"type": "integer", "minimum": 1},
    "subject": {"type": "string", "minLength": 1},
    "segments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "text", "source_refs", "status", "errors"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["hook", "lecture", "worked_example", "watch_out", "transition", "question", "branch", "recap"]},
          "text": {"type": "string"},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["card_id", "scope", "id"], "properties": {"card_id": {"type": "string"}, "scope": {"enum": ["concept_card", "this_card"]}, "id": {"type": "string"}}}},
          "visual_cue": {"type": "string", "pattern": "^\\[show: "},
          "status": {"enum": ["passed", "flagged"]},
          "errors": {"type": "array", "items": {"type": "string"}},
          "attempts": {"type": "integer", "minimum": 1, "maximum": 3},
          "condition": {"type": ["object", "null"]}
        }
      }
    },
    "validation": {"type": "object", "required": ["passed", "final_rule_violations", "coverage_errors", "style"], "properties": {"passed": {"type": "boolean"}, "final_rule_violations": {"type": "integer", "minimum": 0}}},
    "route_plan": {"type": "array"},
    "delivery_policy": {"type": "object", "required": ["main_path", "conditional_segments_are_not_read_sequentially"]}
  }
}
